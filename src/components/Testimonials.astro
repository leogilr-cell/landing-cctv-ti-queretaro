---
import siteConfig from '../content/site-config.json';

const { links, business } = siteConfig;
const reviewUrl = links.googleReview || links.googleReviewFallback;
---

<section id="testimonios" class="py-16 md:py-20 bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4">
      A nuestros clientes les gusta nuestro trabajo
    </h2>
    <p class="text-gray-600 max-w-2xl mx-auto mb-8 leading-relaxed">
      Tu opinión nos ayuda a mejorar y a que más personas en Querétaro confíen en
      {business.name}. Si ya trabajamos contigo, nos encantaría leer tu experiencia.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={reviewUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center gap-2 bg-[#4285F4] hover:bg-[#3367D6] text-white font-semibold px-6 py-3 rounded-lg transition-colors"
      >
        <!-- Logo G de Google -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="w-5 h-5" aria-hidden="true">
          <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3 0 5.8 1.2 7.9 3l5.7-5.7A19.9 19.9 0 0 0 24 4 20 20 0 1 0 44 24c0-1.3-.1-2.7-.4-3.9z"/>
          <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3 0 5.8 1.2 7.9 3l5.7-5.7A19.9 19.9 0 0 0 24 4 21 21 0 0 0 6.3 14.7z"/>
          <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 34.9 26.7 36 24 36c-5.2 0-9.7-3.3-11.3-8l-6.5 5C8.9 41.2 15.9 44 24 44z"/>
          <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3a12 12 0 0 1-4.1 5.6l6.2 5.2C36.9 41 44 36 44 24c0-1.3-.1-2.7-.4-3.9z"/>
        </svg>
        Déjanos tu reseña en Google
      </a>
      <a
        href="#contacto"
        class="inline-flex items-center justify-center bg-white border border-gray-300 hover:border-brand hover:text-brand text-gray-700 font-semibold px-6 py-3 rounded-lg transition-colors"
      >
        ¿Aún no eres cliente? Contáctanos
      </a>
    </div>
  </div>
</section>
