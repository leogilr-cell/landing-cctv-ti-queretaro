---
import siteConfig from '../content/site-config.json';

const { business, links, mapEmbed } = siteConfig;
const wa = business.whatsapp;
const waValid = wa && !wa.startsWith('[COMPLETAR');
const waLink = waValid ? `https://wa.me/${wa}` : '#';
const telHref = business.phone ? `tel:${business.phone.replace(/[^0-9+]/g, '')}` : '#';
---

<footer class="bg-gray-900 text-gray-300">
  <!-- Mapa -->
  <div class="border-b border-gray-800">
    <iframe
      src={mapEmbed}
      width="100%"
      height="400"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      title="Ubicación del negocio en Santiago de Querétaro"
      class="block w-full"
    ></iframe>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 grid grid-cols-1 md:grid-cols-3 gap-10">
    <!-- Contacto -->
    <div>
      <h3 class="text-white font-bold text-lg mb-4">Contacto</h3>
      <ul class="space-y-3 text-sm">
        <li class="flex gap-3 items-start">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-brand-light mt-0.5 shrink-0" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>{business.address}</span>
        </li>
        {business.phone && (
          <li class="flex gap-3 items-center">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-brand-light shrink-0" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href={telHref} class="hover:text-white transition-colors">{business.phone}</a>
          </li>
        )}
        {waValid && (
          <li class="flex gap-3 items-center">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor" class="w-5 h-5 text-brand-light shrink-0" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
            <a href={waLink} target="_blank" rel="noopener" class="hover:text-white transition-colors">
              WhatsApp
            </a>
          </li>
        )}
        {business.email && (
          <li class="flex gap-3 items-center">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-brand-light shrink-0" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <a href={`mailto:${business.email}`} class="hover:text-white transition-colors">{business.email}</a>
          </li>
        )}
        <li class="flex gap-3 items-start">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-brand-light mt-0.5 shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{business.hours}</span>
        </li>
      </ul>
    </div>

    <!-- Redes sociales -->
    <div>
      <h3 class="text-white font-bold text-lg mb-4">Síguenos</h3>
      <div class="flex gap-4">
        {links.facebook && !links.facebook.startsWith('[COMPLETAR') && (
          <a href={links.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="w-10 h-10 rounded-full bg-gray-800 hover:bg-brand flex items-center justify-center text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12z"/></svg>
          </a>
        )}
        {links.instagram && !links.instagram.startsWith('[COMPLETAR') && (
          <a href={links.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="w-10 h-10 rounded-full bg-gray-800 hover:bg-brand flex items-center justify-center text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.9.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.9.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.9-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.9-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 3.2A6.6 6.6 0 1 0 18.6 12 6.6 6.6 0 0 0 12 5.4zm0 10.9A4.3 4.3 0 1 1 16.3 12 4.3 4.3 0 0 1 12 16.3zm6.8-11.2a1.5 1.5 0 1 1-1.5-1.5 1.5 1.5 0 0 1 1.5 1.5z"/></svg>
          </a>
        )}
      </div>
      <p class="text-sm mt-4 leading-relaxed">
        Servicio técnico profesional en {business.serviceArea}. Cotiza en minutos por WhatsApp.
      </p>
    </div>

    <!-- Aviso de privacidad -->
    <div>
      <h3 class="text-white font-bold text-lg mb-4">Aviso de privacidad</h3>
      <p class="text-sm leading-relaxed mb-4">
        Los datos que nos compartes a través del formulario de contacto o WhatsApp se utilizan
        exclusivamente para darte seguimiento a tu solicitud de cotización o servicio. No los
        vendemos ni los compartimos con terceros.
      </p>
      <p class="text-xs text-gray-500">© {new Date().getFullYear()} {business.name}. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
