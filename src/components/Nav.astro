---
import siteConfig from '../content/site-config.json';

const { business } = siteConfig;
const wa = business.whatsapp;
const waValid = wa && !wa.startsWith('[COMPLETAR');
const waLink = waValid ? `https://wa.me/${wa}` : '#';
---

<nav class="bg-white shadow-sm sticky top-0 z-40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between h-16">
    <a href="/" class="font-extrabold text-brand-dark text-lg">
      {business.name}
    </a>
    <div class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-700">
      <a href="#servicios" class="hover:text-brand transition-colors">Servicios</a>
      <a href="#trabajos" class="hover:text-brand transition-colors">Trabajos</a>
      <a href="#faq" class="hover:text-brand transition-colors">FAQ</a>
      <a href="#contacto" class="hover:text-brand transition-colors">Contacto</a>
      {waValid && (
        <a
          href={waLink}
          target="_blank"
          rel="noopener"
          class="bg-brand hover:bg-brand-dark text-white font-semibold px-4 py-2 rounded-lg transition-colors"
        >
          Cotizar
        </a>
      )}
    </div>
    <a
      href="#contacto"
      class="md:hidden bg-brand hover:bg-brand-dark text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors"
    >
      Contacto
    </a>
  </div>
</nav>
