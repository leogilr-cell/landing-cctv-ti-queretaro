---
import siteConfig from '../content/site-config.json';

const { services } = siteConfig;
---

<section id="servicios" class="py-16 md:py-20 bg-gray-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-3">Nuestros servicios</h2>
      <p class="text-gray-600 max-w-2xl mx-auto">
        Soluciones profesionales de seguridad, informática y telecomunicaciones en Santiago de Querétaro.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((s) => (
        <article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-brand/10 flex items-center justify-center text-brand mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">{s.title}</h3>
          <p class="text-sm text-gray-600 leading-relaxed">{s.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
